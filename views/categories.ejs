<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book categories</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {name: "Book categories" }) %>
        <div class="mx-4">
            <a href="/categories/create"
                class="bg-white text-black px-4 py-2 cursor-pointer hover:bg-white/95 active:scale-95">+
                New
                category</a>
        </div>

        <main class="flex-1 mt-2">
            <ul class="flex flex-col border border-white/20 p-4 m-4 gap-2">
                <% categories.forEach(category=> { %>
                    <li>
                        <%- include('category-card', {id: category.id, name: category.name, description:
                            category.description}) %>
                    </li>
                    <% }); %>
            </ul>
        </main>
        <%- include('footer') %>
</body>

</html>