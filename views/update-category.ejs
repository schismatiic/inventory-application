<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update category</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {name: "Update category" } ) %>
        <main class="flex flex-col flex-1 mt-2 items-center">
            <form class="flex flex-col w-full max-w-11/12 md:max-w-1/2 m-4 border border-white/20 p-4 gap-2"
                action="/categories/<%= id %>/edit" method="POST">
                <label for="categoryName">
                    Name
                </label>
                <input name="categoryName" id="categoryName" class="border border-white/20  px-4 py-2" type="text"
                    placeholder="Science Fiction" value="<%= name %>" required>
                <label for="categoryDescription">
                    Description
                </label>
                <textarea name="categoryDescription" id="categoryDescription" class="border border-white/20  px-4 py-2"
                    placeholder="Stories exploring technology, space, and the possibilities of the future."
                    required><%= description %></textarea>
                <label for="categoryPassword">
                    Password
                </label>
                <input name="categoryPassword" id="categoryPassword" class="border border-white/20  px-4 py-2"
                    type="password" placeholder="********" required>
                <button
                    class="bg-white text-black px-4 py-2 cursor-pointer hover:bg-white/95 active:scale-95 mt-4 w-fit"
                    type="submit">Edit</button>
            </form>
            <% if (locals.errors) {%>
                <ul class="m-4 border border-white/20 p-4 w-fit">
                    <% errors.forEach(function(error) { %>
                        <li class="font-bold">
                            <%= error.msg %>
                        </li>
                        <% }); %>
                </ul>
                <% } %>
        </main>


        <%- include('footer') %>

</body>

</html>