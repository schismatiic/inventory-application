<li class="border border-white/20 p-4">
    <h3 class="font-bold">
        <%= name %>
    </h3>
    <p class="text-sm">
        <span class="font-bold">Author:</span>
        <%= author %>
    </p>
    <p class="text-sm">
        <span class="font-bold">Description:</span>
        <%= description %>
    </p>
    <p class="text-sm">
        <span class="font-bold">Number of pages:</span>
        <%= pages %>
    </p>
    <p class="text-sm">
        <span class="font-bold">Category:</span>
        <%= category %>
    </p>
</li>