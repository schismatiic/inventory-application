<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book details</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {name: "Book details" } ) %>
        <main class="flex flex-col flex-1 mt-2 items-center">
            <div class="flex flex-col w-full max-w-11/12 md:max-w-1/2 m-4 border border-white/20 p-4 gap-2">
                <div class="flex justify-between items-center border-b pb-4 border-white/20">
                    <div>
                        <h3 class="text-2xl font-bold">
                            <%= name %>
                        </h3>
                    </div>
                    <p class="border border-white/20 p-2">
                        <%= category %>
                    </p>
                </div>
                <p>
                    <span class="font-bold">Author:</span>
                    <%= author %>
                </p>
                <p>
                    <span class="font-bold">Description:</span>
                    <%= description %>
                </p>
                <p>
                    <span class="font-bold">Number of pages:</span>
                    <%= pages %>
                </p>
                <div class="mt-4">
                    <a href="/book/<%= id %>/edit"
                        class="bg-white text-black px-4 py-1 cursor-pointer hover:bg-white/95 active:scale-95">Edit</a>
                    <a href="/book/<%= id %>/delete"
                        class="border border-white/20 text-white px-4 py-1 cursor-pointer hover:bg-gray-900 active:scale-95">Delete</a>
                </div>
            </div>
        </main>


        <%- include('footer') %>
</body>

</html>