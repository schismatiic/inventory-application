<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book inventory</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex flex-col min-h-screen bg-black text-white font-extralight">
    <%- include('header', {name: "Book inventory" }) %>
        <div class="mx-4">
            <a href="/create-book"
                class="bg-white text-black px-4 py-2 cursor-pointer hover:bg-white/95 active:scale-95">+
                New
                book</a>
        </div>

        <main class="flex-1 mt-2">
            <ul class="flex flex-col border border-white/20 p-4 m-4 gap-2">
                <% books.forEach(book=> { %>
                    <li>
                        <%- include('book-card', {id: book.id, name: book.name, author: book.author, description:
                            book.description, pages: book.pages, category: book.category}) %>
                    </li>
                    <% }); %>
            </ul>
        </main>
        <%- include('footer') %>
</body>

</html>